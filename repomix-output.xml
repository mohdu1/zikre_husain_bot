from datetime import datetime, timedelta
import gspread
from google.oauth2.service_account import Credentials
import config


class GoogleSheetsManager:
    def __init__(self):
        self.scopes = [
            'https://www.googleapis.com/auth/spreadsheets',
            'https://www.googleapis.com/auth/drive'
        ]
        self.client = None
        self.sheet = None
        self._authenticate()

    def _authenticate(self):
        """Authenticates with Google Sheets API using the Service Account."""
        try:
            creds = Credentials.from_service_account_file(
                config.SERVICE_ACCOUNT_FILE, scopes=self.scopes
            )
            self.client = gspread.authorize(creds)
            self.sheet = self.client.open_by_key(config.SHEET_ID)
        except Exception as e:
            print(f"Error authenticating with Google Sheets: {e}")
            raise

    def _get_worksheet(self, name: str):
        """Fetches a worksheet with basic retry logic for session expiration."""
        try:
            return self.sheet.worksheet(name)
        except gspread.exceptions.APIError:
            self._authenticate()
            return self.sheet.worksheet(name)

    # --- User Management ---
    def get_user(self, telegram_id: int):
        """Returns user dict if registered, else None."""
        ws = self._get_worksheet("Users")
        records = ws.get_all_records()
        for row in records:
            if str(row.get("Telegram_ID")) == str(telegram_id):
                return row
        return None

    def register_user(self, telegram_id: int, chat_id: int, name: str):
        """Registers a new user to the Users sheet."""
        ws = self._get_worksheet("Users")
        ws.append_row([str(telegram_id), str(chat_id), name])

    def get_all_chat_ids(self):
        """Returns a list of all chat IDs for broadcasting."""
        ws = self._get_worksheet("Users")
        records = ws.get_all_records()
        return [str(row["Chat_ID"]) for row in records if row.get("Chat_ID")]

    # --- Duplicate Verification & Logging ---
    def is_duplicate(self, worksheet_name: str, telegram_id: int, date_str: str, value_to_check: str, value_column_key: str) -> bool:
        """Checks if an entry for the same user, date, and activity/kalaam already exists."""
        ws = self._get_worksheet(worksheet_name)
        records = ws.get_all_records()
        for row in records:
            if (str(row.get("ID")) == str(telegram_id) and
                str(row.get("Date")) == str(date_str) and
                str(row.get("Activity", row.get("Kalaam_Focused", ""))).strip().lower() == value_to_check.strip().lower()):
                return True
        return False

    def log_attendance(self, telegram_id: int, name: str, activity: str) -> tuple[bool, str]:
        """Logs attendance if not duplicate. Returns (Success, Message)."""
        now = datetime.now(config.IST)
        date_str = now.strftime("%d-%m-%Y")
        time_str = now.strftime("%H:%M:%S")

        if self.is_duplicate("Attendance_Log", telegram_id, date_str, activity, "Activity"):
            return False, f"⚠️ You have already logged **{activity}** for today! Consistency is great, but duplicate entries are blocked."

        ws = self._get_worksheet("Attendance_Log")
        ws.append_row([str(telegram_id), name, date_str, time_str, activity])
        return True, f"✅ Successfully logged attendance for **{activity}**!"

    def log_riyaz(self, telegram_id: int, name: str, kalaam: str) -> tuple[bool, str]:
        """Logs Riyaz if not duplicate. Returns (Success, Message)."""
        now = datetime.now(config.IST)
        date_str = now.strftime("%d-%m-%Y")
        time_str = now.strftime("%H:%M:%S")

        if self.is_duplicate("Riyaz_Log", telegram_id, date_str, kalaam, "Kalaam_Focused"):
            return False, f"⚠️ You have already logged Riyaz for **{kalaam}** today! Consistency is great, but duplicate entries are blocked."

        ws = self._get_worksheet("Riyaz_Log")
        ws.append_row([str(telegram_id), name, date_str, time_str, kalaam])
        return True, f"🎙️ Successfully logged Riyaz for: **{kalaam}**!"

    # --- Progress Analytics ---
    def get_weekly_progress(self, telegram_id: int) -> int:
        """Calculates distinct days logged in Riyaz or Attendance in the last 7 days (IST)."""
        now = datetime.now(config.IST)
        valid_dates = {(now - timedelta(days=i)).strftime("%d-%m-%Y") for i in range(7)}
        active_days = set()

        for sheet_name in ["Attendance_Log", "Riyaz_Log"]:
            ws = self._get_worksheet(sheet_name)
            records = ws.get_all_records()
            for row in records:
                if str(row.get("ID")) == str(telegram_id):
                    row_date = str(row.get("Date"))
                    if row_date in valid_dates:
                        active_days.add(row_date)

        return len(active_days)


# Singleton instance
db = GoogleSheetsManager()
